# ==============================================================================
# WuWa Cutscene Studio - Git Ignore Rules
# ==============================================================================

# Node / Frontend dependencies & builds
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Tauri & Rust build artifacts
src-tauri/target/
target/
**/*.rs.bk
*.exe
*.pdb
*.dll
*.so
*.dylib

# Application Config, Secrets & Runtime Caches
app_config.json
config.json
*.key
cache/
.cache/
*.cache

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
debug_wwiser.log
wwconfig*.txt

# Local Downloads, Datamine exports & temporary media
txtp/
txtp_test/
captions/
data/
tools/
renders/
output/
temp/
scratch/
.system_generated/
*.wav
*.mp4
*.mkv
*.webm
*.test.*
*.tmp
*.bak

# Operating System & IDE Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.*
!.env.example
