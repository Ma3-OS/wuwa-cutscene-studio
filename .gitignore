# ==============================================================================
# WuWa Cutscene Studio - Production Git Ignore Rules
# Target: Ma3-OS / WuWa Cutscene Studio
# ==============================================================================

# Node / Frontend dependencies & build artifacts
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Tauri, Rust & C# .NET build artifacts
src-tauri/target/
target/
**/*.rs.bk
**/bin/
**/obj/
**/publish/
src-tauri/extractor/bin/
src-tauri/extractor/obj/
src-tauri/extractor/publish/
*.exe
*.pdb
*.dll
*.so
*.dylib
*.msi
*.zip

# Game archives, pak files & proprietary audio banks
*.pak
*.sig
*.utoc
*.ucas
*.bnk
*.wem
*.pck
*.bk2
*.usm
*.bik

# Workspace output directories & runtime caches
export/
output/
render/
renders/
cache/
.cache/
*.cache
logs/
*.log
txtp/
txtp_test/
captions/
test_wem_out/
process_pipeline_archive/
temp/
scratch/
.system_generated/

# Application configuration, decrypted keys & credentials
app_config.json
config.json
*.key
keys.json
data/keys.json
src-tauri/keys.json
**/vid.json
.env
.env.*
!.env.example

# Datamined text databases & local game data
data/*.json
data/*.db
data/*.txt
!data/.gitkeep

# External binaries & tools
tools/
src-tauri/tools/
wwconfig*.txt
debug_wwiser.log

# Test artifacts, renders & subtitle dumps
test_*.*
compare_*.*
crop_*.*
inspect_*.*
*.ass
*.srt
*.wav
*.mp4
*.mkv
*.webm
in.txt
out.txt
*.tmp
*.bak
scripts/*.txt
scripts/*.report


# IDE & Operating System artifacts
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
